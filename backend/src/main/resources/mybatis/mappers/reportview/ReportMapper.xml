<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.esg.platform.domain.reportview.mapper.ReportMapper">

    <resultMap id="ReportResultMap" type="com.esg.platform.domain.reportview.dto.ReportDto">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="version" column="version"/>
        <result property="content" column="content"/>
        <result property="scope" column="scope"/>
        <result property="targetYear" column="target_year"/>
        <result property="fileUrl" column="file_url"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findAll" resultMap="ReportResultMap">
        SELECT gr.id, gr.title, gr.version, gr.content, gr.scope, gr.target_year, gr.file_url, gr.created_at
        FROM generated_reports gr
        JOIN report_templates rt ON gr.template_id = rt.id
        WHERE rt.company_id = 1
          AND gr.is_public = TRUE
        ORDER BY gr.created_at DESC
    </select>

</mapper>