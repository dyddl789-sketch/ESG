<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.esg.platform.domain.company.mapper.CompanyMapper">

    <resultMap id="CompanyResultMap" type="com.esg.platform.domain.company.dto.CompanyDto">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="industry" column="industry"/>
        <result property="scale" column="scale"/>
        <result property="businessNumber" column="business_number"/>
        <result property="representative" column="representative"/>
    </resultMap>

    <select id="findById" parameterType="Long" resultMap="CompanyResultMap">
        SELECT
            c.id,
            c.name,
            i.name AS industry,
            c.company_scale AS scale,
            c.business_number,
            c.representative_name AS representative
        FROM companies c
        JOIN industry_types i ON c.industry_code = i.code
        WHERE c.id = #{id}
    </select>

    <update id="update" parameterType="com.esg.platform.domain.company.dto.CompanyDto">
        UPDATE companies
        SET name = #{name},
            industry_code = #{industry},
            company_scale = #{scale},
            business_number = #{businessNumber},
            representative_name = #{representative}
        WHERE id = #{id}
    </update>

</mapper>